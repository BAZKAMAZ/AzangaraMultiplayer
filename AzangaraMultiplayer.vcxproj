         and keeps working it out as the stages add subsystems. -->
    <AzForgeModRequires>
    </AzForgeModRequires>
    <!-- Not derived, ever: the loader withholds the memory and patching table until a mod says the
         word. It is used to keep the game running when its window is not the one in front. -->
    <AzForgeModCapabilities>interop</AzForgeModCapabilities>
    <AzForgeGameDir>C:\Games\az_orginal</AzForgeGameDir>
    <AzForgeSdkDir>C:\Users\gdnew\OneDrive\Documents\Visual Studio 2022\Projects\AzForge\sdk\</AzForgeSdkDir>
    <AmodPackPath>C:\Users\gdnew\OneDrive\Documents\Visual Studio 2022\Projects\AzForge\Release\AmodPack.exe</AmodPackPath>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
